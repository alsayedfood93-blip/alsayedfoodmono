# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://alsayed:alsayed_dev_password@localhost:5432/alsayed?schema=public"

# NestJS API
NODE_ENV=development
PORT=3002

# Allowed CORS origins
WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001

# Auth (use strong, unique secrets in production)
JWT_ACCESS_SECRET="change-me-dev-access-secret"
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Backend image storage
# Local: relative to apps/api. Production: absolute persistent path
# (e.g. Hostinger persistent disk / bind mount / Docker volume).
UPLOAD_ROOT=./uploads
