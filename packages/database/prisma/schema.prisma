generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin account. Passwords are bcrypt hashes so that existing Laravel
/// bcrypt hashes can be migrated without forcing a password reset.
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]

  @@map("admins")
}

/// Persistent refresh session. Only a hash of the opaque refresh secret is
/// stored, never the raw secret. Logout revokes the session, which makes
/// the associated refresh credential unusable.
model AdminSession {
  id        String    @id @default(cuid())
  adminId   Int
  tokenHash String
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model Category {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  imagePath   String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  size        String?
  /// Legacy integer price semantics are preserved until the business
  /// confirms currency/decimal requirements.
  price       Int?
  ingredients String[] @default([])
  imagePath   String?
  categoryId  Int
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Restrict prevents destructive deletion of a category that still has
  /// products. The application returns an HTTP 409 in that situation.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([isActive, sortOrder])
  @@index([isFeatured])
  @@map("products")
}

/// Correct naming; the legacy `ceo_messge` typo is intentionally not reused.
model CeoMessage {
  id          Int      @id @default(autoincrement())
  name        String
  title       String
  description String
  imagePath   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ceo_messages")
}

model HeroContent {
  id                  Int      @id @default(autoincrement())
  eyebrow             String?
  title               String
  highlightedText     String?
  description         String?
  primaryButtonText   String?
  primaryButtonLink   String?
  secondaryButtonText String?
  secondaryButtonLink String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  images HeroImage[]

  @@map("hero_content")
}

/// Background slides for the homepage hero. Ordered by sortOrder ascending.
model HeroImage {
  id        Int      @id @default(autoincrement())
  heroId    Int
  imagePath String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hero HeroContent @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId, sortOrder])
  @@map("hero_images")
}

model SiteSettings {
  id           Int      @id @default(autoincrement())
  companyName  String
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  logoPath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
