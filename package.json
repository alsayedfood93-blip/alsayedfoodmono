{
  "name": "alsayedcoldrinks",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @alsayed/database generate",
    "db:migrate": "pnpm --filter @alsayed/database migrate",
    "db:deploy": "pnpm --filter @alsayed/database deploy",
    "db:studio": "pnpm --filter @alsayed/database studio"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
